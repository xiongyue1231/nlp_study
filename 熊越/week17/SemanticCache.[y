import os
import numpy as np
import redis
from typing import Optional, List, Union, Callable, Any
import faiss
import uuid

class SemanticCache:
    def __init__(
            self,
            name: str,
            embedding_method: Callable[[Union[str, List[str]]], Any],
            ttl: int=3600*24,
            redis_url: str = "localhost",
            redis_port: int = 6379,
            redis_password: str = None,
            distance_threshold=0.1
    ):
        self.name = name
        self.redis = redis.Redis(
            host=redis_url,
            port=redis_port,
            password=redis_password,
            decode_responses=True
        )
        self.ttl = ttl
        self.distance_threshold = distance_threshold
        self.embedding_method = embedding_method
        self.index_key = f"{self.name}:index_ids"
        
        if os.path.exists(f"{self.name}.index"):
            self.index = faiss.read_index(f"{self.name}.index")
        else:
            self.index = None

    def store(self, prompt: Union[str, List[str]], response: Union[str, List[str]]):
        if isinstance(prompt, str):
            prompt = [prompt]
            response = [response]

        embedding = self.embedding_method(prompt)
        if len(embedding.shape) == 1:
            embedding = embedding.reshape(1, -1)
            
        if self.index is None:
            self.index = faiss.IndexFlatL2(embedding.shape[1])

        self.index.add(embedding)
        faiss.write_index(self.index, f"{self.name}.index")

        try:
            with self.redis.pipeline() as pipe:
                for q, a in zip(prompt, response):
                    key_id = str(uuid.uuid4())
                    pipe.setex(f"{self.name}:key:{key_id}", self.ttl, a)
                    pipe.setex(f"{self.name}:prompt:{key_id}", self.ttl, q)
                    pipe.rpush(self.index_key, key_id)

                return pipe.execute()
        except Exception as e:
            import traceback
            traceback.print_exc()
            return -1

    def call(self, prompt: str):
        if self.index is None:
            return None

        embedding = self.embedding_method(prompt)
        if len(embedding.shape) == 1:
            embedding = embedding.reshape(1, -1)

        dis, ind = self.index.search(embedding, k=10)
        
        valid_results = []
        index_ids = self.redis.lrange(self.index_key, 0, -1)
        
        for i, (distance, idx) in enumerate(zip(dis[0], ind[0])):
            if distance <= self.distance_threshold and idx < len(index_ids):
                key_id = index_ids[idx]
                response = self.redis.get(f"{self.name}:key:{key_id}")
                if response:
                    valid_results.append({
                        "response": response,
                        "distance": float(distance)
                    })
        
        if not valid_results:
            return None
        
        return valid_results

    def check(self, prompt: str):
        return self.call(prompt)

    def clear_cache(self):
        index_ids = self.redis.lrange(self.index_key, 0, -1)
        if index_ids:
            keys_to_delete = [f"{self.name}:key:{key_id}" for key_id in index_ids]
            keys_to_delete.extend([f"{self.name}:prompt:{key_id}" for key_id in index_ids])
            keys_to_delete.append(self.index_key)
            self.redis.delete(*keys_to_delete)
            
        if os.path.exists(f"{self.name}.index"):
            os.unlink(f"{self.name}.index")
            self.index = None

if __name__ == "__main__":
    def get_embedding(text):
        if isinstance(text, str):
            text = [text]
        
        rng = np.random.default_rng(seed=42)
        return np.array([rng.normal(size=768) for t in text])


    embed_cache = SemanticCache(
        name="semantic_cache",
        embedding_method=get_embedding,
        ttl=360,
        redis_url="localhost",
    )

    embed_cache.clear_cache()

    embed_cache.store(prompt="hello world", response="hello world1232")
    print(embed_cache.call(prompt="hello world"))

    embed_cache.store(prompt="hello my name", response="nihao")
    print(embed_cache.call(prompt="hello world"))
